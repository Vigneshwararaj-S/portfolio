---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { links } from '../site';

interface Props {
  title: string;
  description: string;
  image?: string;
  current?: 'work' | 'journal' | 'about';
}
const { title, description, image = '/images/og.jpg', current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Journal" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0c0d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600&family=Passion+One:wght@700;900&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <nav class="nav" aria-label="Main">
      <div class="nav-left">
        <a class="mark" href="/" aria-label="Vigneshwararaj Sathianarayanan, home">VR</a>
        <a class="open-badge" href="/#contact"><span class="open-dot" aria-hidden="true"></span><span class="hide">Open to thesis work · from Jan 2027</span><span class="only-sm">Open to thesis · 2027</span></a>
      </div>
      <ul>
        <li class="hide"><a href="/#work" aria-current={current === 'work' ? 'page' : undefined}>Work</a></li>
        <li class="nav-journal"><a href="/journal/" aria-current={current === 'journal' ? 'page' : undefined}>Journal</a></li>
        <li class="hide"><a href="/#about" aria-current={current === 'about' ? 'page' : undefined}>About</a></li>
        <li class="nav-cv"><a href={links.cv}>CV</a></li>
        <li><a class="btn" href="/#contact">Get in touch</a></li>
      </ul>
    </nav>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // The nav gets a solid background once the page has moved.
      const nav = document.querySelector('.nav')!;
      const hero = document.querySelector<HTMLElement>('.hero');
      const onScroll = () => {
        // Pages without the hero keep the small seal from the start, so it never covers their title.
        const limit = hero ? hero.offsetHeight - innerHeight : -1;
        nav.classList.toggle('scrolled', scrollY > limit);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // The badge stands in for the seal: it shows only once the seal has left the screen.
      const seal = document.querySelector('.seal-hero');
      if (seal && 'IntersectionObserver' in window) {
        const barHeight = nav.getBoundingClientRect().height;
        new IntersectionObserver(([entry]) => nav.classList.toggle('show-badge', !entry.isIntersecting), {
          rootMargin: `-${Math.round(barHeight)}px 0px 0px 0px`,
        }).observe(seal);
      } else {
        nav.classList.add('show-badge');
      }

      // Section entrances: each [data-rise] element rises once as it enters the screen.
      document.querySelectorAll('.prose > *').forEach((el, i) => {
        el.setAttribute('data-rise', '');
        (el as HTMLElement).style.setProperty('--d', String(i % 3));
      });
      const items = document.querySelectorAll<HTMLElement>('[data-rise]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
