---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MoreWork from '../../components/MoreWork.astro';
import { formatDate } from '../../site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const entries = (await getCollection('journal', (e) => e.data.project === project.id && !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${data.title} — Vigneshwararaj Sathianarayanan`} description={data.summary} image={data.image} current="work">
  <div class="page">
    <header>
      <h1 class="page-title" data-rise>{data.title}</h1>
      <p class="page-lead" data-rise style="--d:1">{data.summary}</p>
      <p class="page-meta" data-rise style="--d:2"><span>{data.kind}</span><span>{data.year}</span>{data.repo && <a class="link" href={data.repo}>Code on GitHub</a>}</p>
    </header>

    {data.image && (
      <figure class:list={['page-hero', { fit: data.imageFit === 'contain' }]} data-rise>
        <img src={data.image} alt={data.imageAlt} width="1920" height="1280" />
        <figcaption class="caption">{data.imageAlt}.</figcaption>
      </figure>
    )}

    <div class="detail">
      <aside>
        {data.results.length > 0 && (
          <div data-rise>
            <h2 class="side-title">Results</h2>
            <dl class="results">
              {data.results.map((r) => <div><dt>{r.figure}</dt><dd>{r.text}</dd></div>)}
            </dl>
          </div>
        )}
        {data.stack.length > 0 && (
          <div data-rise>
            <h2 class="side-title">Built with</h2>
            <ul class="stack">{data.stack.map((s) => <li>{s}</li>)}</ul>
          </div>
        )}
      </aside>
      <article class="prose">
        <Content />
      </article>
    </div>

    {entries.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title" class="head" data-rise>Build journal</h2>
        <div class="rows">
          {entries.map((e, i) => (
            <a href={`/journal/${e.id}/`} data-rise style={`--d:${i}`}>
              <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
              <h3>{e.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <MoreWork exclude={project.id} />
  </div>
</Base>
