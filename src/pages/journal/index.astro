---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MoreWork from '../../components/MoreWork.astro';
import { formatDate } from '../../site';

const projects = await getCollection('projects');
const projectName = (id: string) => projects.find((p) => p.id === id)?.data.short ?? id;
const entries = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Journal — Vigneshwararaj Sathianarayanan" description="Build notes on my projects: what I tried, what broke, and what I learned." current="journal">
  <div class="page">
    <header class="journal-head">
      <div>
        <h1 class="page-title" data-rise>Journal</h1>
        <p class="page-lead" data-rise style="--d:1">Build notes on my projects: what I tried, what broke, and what I learned. Newest first.</p>
      </div>
      <figure data-rise style="--d:2">
        <img src="/images/shadow.webp" alt="Vigneshwararaj's shadow falling on a sunlit door" width="1400" height="1921" />
      </figure>
    </header>
    <div class="rows" style="margin-top:72px">
      {entries.map((e, i) => (
        <a href={`/journal/${e.id}/`} data-rise style={`--d:${i}`}>
          <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
          <h2>{e.data.title}</h2>
          <span class="tag">{projectName(e.data.project)}</span>
          <p>{e.data.summary}</p>
        </a>
      ))}
    </div>
    <MoreWork />
  </div>
</Base>
